{
  "name": "@root/yakumo",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "external/*",
    "fixtures/*",
    "packages/*"
  ],
  "license": "MIT",
  "scripts": {
    "lint": "eslint --cache",
    "yakumo": "node --import tsx packages/core/src/cli",
    "build": "yarn yakumo esbuild && yarn yakumo tsc",
    "test": "yarn yakumo vitest yakumo-test --import tsx",
    "test:text": "shx rm -rf coverage && yarn test --coverage --coverage.reporter text",
    "test:json": "shx rm -rf coverage && yarn test --coverage --coverage.reporter json",
    "test:html": "shx rm -rf coverage && yarn test --coverage --coverage.reporter html"
  },
  "devDependencies": {
    "@cordisjs/eslint-config": "^1.1.1",
    "@cordisjs/plugin-cli": "^1.1.2",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "shx": "^0.4.0",
    "tsx": "npm:@cordiverse/tsx@4.19.3-fix.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "resolutions": {
    "vite": "^7.3.2"
  }
}
