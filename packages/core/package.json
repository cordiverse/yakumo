{
  "name": "yakumo",
  "description": "Manage complex workspaces with ease",
  "version": "3.2.1",
  "type": "module",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "bin": "lib/cli.js",
  "exports": {
    ".": "./lib/index.js",
    "./cli": "./lib/cli.js",
    "./lock": "./lib/lock.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "files": [
    "lib"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cordiverse/yakumo.git"
  },
  "bugs": {
    "url": "https://github.com/cordiverse/yakumo/issues"
  },
  "homepage": "https://github.com/cordiverse/yakumo",
  "keywords": [
    "monorepo",
    "workspace",
    "cli",
    "script"
  ],
  "cordis": {
    "hidden": true,
    "ecosystem": {
      "inject": [
        "yakumo"
      ],
      "pattern": [
        "yakumo-*"
      ]
    }
  },
  "devDependencies": {
    "@types/picomatch": "^3.0.2",
    "@types/prompts": "^2.4.9",
    "@types/which-pm-runs": "^1.0.2",
    "@types/yargs-parser": "^21.0.3"
  },
  "dependencies": {
    "@cordisjs/plugin-cli": "^1.1.2",
    "@cordisjs/plugin-include": "^1.2.0",
    "@cordisjs/plugin-loader": "^1.0.0-rc.9",
    "@npm/types": "^2.1.0",
    "@yarnpkg/parsers": "^3.1.0",
    "cordis": "^4.0.0-rc.12",
    "cosmokit": "^1.8.1",
    "detect-indent": "^7.0.2",
    "execa": "^9.6.1",
    "get-registry": "^1.2.0",
    "globby": "^14.1.0",
    "kleur": "^4.1.5",
    "ora": "^8.2.0",
    "p-map": "^7.1.1",
    "picomatch": "^4.0.7",
    "prompts": "^2.4.2",
    "semver": "^7.8.6",
    "which-pm-runs": "^1.1.0",
    "yaml": "^2.9.1"
  }
}
